---
// Foto de un colegial: la foto principal de su artículo (o una silueta si no tiene). Ver src/lib/fotos.ts.
import type { Colegial } from '../lib/datos';
import type { Tamano } from '../lib/archivos';
import { urlFoto } from '../lib/fotos';

interface Props { c: Colegial; clase?: string; perezosa?: boolean; tam?: Tamano }
const { c, clase, perezosa = true, tam = 320 } = Astro.props;
---
<img class={clase} loading={perezosa ? 'lazy' : 'eager'} src={urlFoto(c.id, tam)} alt={c.mote} />
