---
// Elige la ficha lateral según el tipo de artículo
import type { Datos } from '../../lib/datos';
import type { Articulo } from '../../lib/wiki';
import { tipoBloques } from '../../lib/bloques';
import FichaColegial from './colegial/Ficha.astro';
import FichaCurso from './curso/Ficha.astro';
import FichaDirector from './director/Ficha.astro';
import FichaEvento from './evento/Ficha.astro';
import FichaHabitacion from './habitacion/Ficha.astro';
import FichaLocalidad from './localidad/Ficha.astro';
import FichaLibro from './libro/Ficha.astro';
import FichaColegio from './colegio/Ficha.astro';
import FichaDistincion from './distinciones/Ficha.astro';
import Infobox from '../infobox/Infobox.astro';
import type { Archivo } from '../../lib/archivos';

// imagen: foto principal del artículo (si la tiene, sale en la ficha en lugar de la imagen por defecto)
interface Props { articulo: Articulo; e: any; d: Datos; imagen?: Archivo | null }
const { articulo, e, d, imagen = null } = Astro.props;

// fichas de artículos vinculados a un dato (necesitan ese dato: e)
const fichasDeDatos: Record<string, any> = {
  colegial: FichaColegial, curso: FichaCurso, director: FichaDirector, evento: FichaEvento,
  habitacion: FichaHabitacion, localidad: FichaLocalidad, libro: FichaLibro,
};
const tipo = tipoBloques(articulo);
const ConDato = e ? fichasDeDatos[articulo.tipo] : null;
const distincion = ['premio', 'decano', 'consejero', 'consejo'].includes(tipo);
// los artículos sin ficha propia (libres, estudios…) con foto principal tienen una ficha mínima: título y foto
const soloFoto = imagen && tipo !== 'colegio' && !distincion && !ConDato;
---
{tipo === 'colegio' && <FichaColegio d={d} imagen={imagen} />}
{distincion && <FichaDistincion articulo={articulo} d={d} imagen={imagen} />}
{ConDato && <ConDato articulo={articulo} e={e} d={d} imagen={imagen} />}
{soloFoto && <Infobox titulo={articulo.titulo} imagen={imagen} />}
