---
// Ficha del artículo principal «Colegio Mayor Santa Cruz»
import type { Archivo } from '../../../lib/archivos';
import type { Datos } from '../../../lib/datos';
import Infobox from '../../infobox/Infobox.astro';
import Fila from '../../infobox/Fila.astro';
import Enlace from '../../Enlace.astro';

interface Props { d: Datos; imagen?: Archivo | null }
const { d } = Astro.props;
const imagenPrincipal = Astro.props.imagen ?? null;   // foto principal del artículo (sustituye a la de la ficha)
const curso = d.cursos.get(d.actual)!;
---
<Infobox imagen={imagenPrincipal} titulo="Colegio Mayor Santa Cruz" pie="Sello del colegio">
  <img slot="imagen" src="/logo.png" style="width:180px" alt="Sello del colegio" />
  <Fila e="Sede" v="Cardenal Mendoza (masculina)" />
  <Fila e="Ciudad" v="Valladolid, España" />
  <Fila e="Fundador histórico" v="Cardenal Pedro González de Mendoza" />
  <Fila e="Director" si={!!curso.director}><Enlace tipo="director" clave={curso.director?.id}>{curso.director?.nombre}</Enlace></Fila>
  <Fila e="Curso actual" si><Enlace tipo="curso" clave={d.actual}>{d.actual}</Enlace></Fila>
  <Fila e="Colegiales" v={curso.miembros.length} />
  <Fila e="Habitaciones" v={`${d.habs.size} en 3 plantas`} />
  <Fila e="Libros en biblioteca" v={d.libros.length} />
  <Fila e="Apodo" v="«El bueno»" />
</Infobox>
