---
import type { Archivo } from '../../../lib/archivos';
import type { Evento, Datos } from '../../../lib/datos';
import type { Articulo } from '../../../lib/wiki';
import { fecha } from '../../../lib/formato';
import { urlArticulo } from '../../../lib/urls';
import Infobox from '../../infobox/Infobox.astro';
import Fila from '../../infobox/Fila.astro';
import Enlace from '../../Enlace.astro';

interface Props { articulo: Articulo; e: Evento; d: Datos; imagen?: Archivo | null }
const { articulo, e: ev, d } = Astro.props;
const imagenPrincipal = Astro.props.imagen ?? null;   // foto principal del artículo (sustituye a la de la ficha)
const dir = d.cursos.get(ev.cursoid)?.director;
const tieneCronica = !!ev.info || /^##\s*cr[oó]nica/im.test(articulo.contenido ?? '');
---
{!tieneCronica && <div class="ambox">No hay crónica de este evento. ¿Estuviste? Edita el texto desde <a href={`${urlArticulo(articulo.id)}/codigo`}>aquí</a>.</div>}
<Infobox imagen={imagenPrincipal} titulo={ev.nombre}>
  <Fila e="Curso" si><Enlace tipo="curso" clave={ev.cursoid}>{ev.cursoid}</Enlace></Fila>
  <Fila e="Inicio" v={fecha(ev.inicio)} />
  <Fila e="Fin" v={fecha(ev.fin)} />
  <Fila e="Director" si={!!dir}><Enlace tipo="director" clave={dir?.id}>{dir?.nombre}</Enlace></Fila>
  <Fila e="Fotos" si={!!ev.fotosurl}><a href={ev.fotosurl!} target="_blank" rel="noopener">Ver álbum</a></Fila>
</Infobox>
